# Names the Sentry organization and project that debug symbols are uploaded to, read both by the
# app target's "Upload Debug Symbols to Sentry" build phase and by the release lanes, so the two
# cannot drift.
#
# Deliberately no [auth] section: the token is a secret and reaches sentry-cli through
# SENTRY_AUTH_TOKEN — a GitHub Actions secret on CI, and fastlane/.env locally. Never add one here.
[defaults]
org=timcodes
project=fart
