require "fileutils"
require "json"
require "open3"
require "shellwords"
require "tmpdir"
require "xcodeproj"

# Xcode 26 writes a multi-line build-phase script as a list of lines, a format xcodeproj 1.28.1
# rejects: it type-checks `shellScript` as a String and raises on an Array. gym parses the project to
# enumerate its build configurations, so without this an archive dies before xcodebuild is ever
# reached. Joining the lines back together yields exactly the script the attribute expects. Remove
# this once xcodeproj understands the newer format.
module JoinsMultiLineShellScripts
  def shell_script=(value)
    super(value.is_a?(Array) ? value.join("\n") : value)
  end
end
Xcodeproj::Project::Object::PBXShellScriptBuildPhase.prepend(JoinsMultiLineShellScripts)

default_platform :ios

APP_IDENTIFIER = "codes.tim.FART"
SCHEME = "FART"
XCODEPROJ = "Flight Assessment of Risk Tool.xcodeproj"

# Where archives and dSYMs land, so a CI run can collect them as artifacts.
OUTPUT_DIRECTORY = "build"

# Each platform this app ships. `destination` selects the SDK to archive against; `deliver` is the
# name App Store Connect knows the platform by; `match` is the platform whose stored App Store profile
# the export signs with — a profile is platform-specific, and exportArchive rejects one built for
# another. The app target also builds for visionOS, but there is no visionOS App Store listing, so it
# is not released here.
PLATFORMS = {
  "iOS"   => { destination: "generic/platform=iOS",   deliver: "ios", match: "ios",
               connect: "IOS" },
  # A Mac App Store submission ships as a .pkg, which the Apple Distribution certificate cannot
  # sign — that takes the separate Mac Installer Distribution certificate.
  "macOS" => { destination: "generic/platform=macOS", deliver: "osx", match: "macos",
               sdk: "macosx", additional_cert_types: ["mac_installer_distribution"],
               connect: "MAC_OS" }
}.freeze

# The Sentry project the release lanes upload dSYMs and sources to. `sentry-cli` reads
# SENTRY_AUTH_TOKEN from the environment itself; `.sentryclirc` is committed and so holds only the
# project's identity.
SENTRY_ORG = "timcodes"
SENTRY_PROJECT = "fart"

# Signing credentials live in a private repository, everything in it encrypted under one
# MATCH_PASSWORD: the Apple Distribution certificate (managed by _match_) and the App Store Connect
# API key (decrypted by that repository's own `bin/api-key`). Neither is ever written to this
# working tree. CI checks the repository out and sets CERTIFICATES_REPO; a local run falls back to a
# clone alongside the other repositories.
DEFAULT_CERTIFICATES_REPO = File.expand_path("~/Repositories/certificates")

def certificates_repo
  path = ENV.fetch("CERTIFICATES_REPO", DEFAULT_CERTIFICATES_REPO)
  return path if Dir.exist?(path)

  UI.user_error!("No signing credentials at #{path} — clone the certificates repository there, " \
                 "or point CERTIFICATES_REPO at an existing checkout.")
end

# Secrets reach every lane through the environment, and only through the environment: repository
# secrets on CI, and `fastlane/.env` — which fastlane loads on startup and git ignores — locally.
def required_env(name)
  value = ENV.fetch(name, nil)
  return value unless value.nil? || value.empty?

  UI.user_error!("#{name} is not set. Put it in fastlane/.env (git-ignored, loaded automatically; " \
                 "see fastlane/.env.example) or export it before running this lane.")
end

# gym never hands App Store Connect credentials to xcodebuild, so `-allowProvisioningUpdates` on its
# own has no account to authenticate with and automatic signing cannot fetch a distribution profile.
# xcodebuild takes the key directly through its own flags. They want a path, so the key is written to
# a private temp file that goes away when the process exits — it never lands in the working tree.
def provisioning_authentication_args
  key = Fastlane::Actions.lane_context[Fastlane::Actions::SharedValues::APP_STORE_CONNECT_API_KEY]
  UI.user_error!("ensure_api_key has to run before an archive can be signed.") if key.nil?

  directory = Dir.mktmpdir("asc-api-key")
  at_exit { FileUtils.remove_entry(directory, true) }
  path = File.join(directory, "AuthKey_#{key[:key_id]}.p8")
  File.write(path, key[:key])
  FileUtils.chmod(0o600, path)

  "-authenticationKeyPath #{path.shellescape} " \
    "-authenticationKeyID #{key[:key_id].shellescape} " \
    "-authenticationKeyIssuerID #{key[:issuer_id].shellescape}"
end

# `upload_to_app_store` clears every slot it uploads into, so an empty directory would strip the
# screenshots from the product page rather than leave the ones already there alone. A screenshots run
# that was interrupted, or that captured nothing, has to stop before publishing its silence.
#
# The path is anchored to this file so it names the same folder however the lane was invoked.
def verify_screenshots_present
  directory = File.expand_path("screenshots", __dir__)
  return if Dir.glob(File.join(directory, "**", "*.png")).any?

  UI.user_error!("No screenshots under #{directory} — run the screenshots lane first. Uploading an " \
                 "empty set would clear the screenshots already on the App Store.")
end

# Every screenshot set on the version currently open for editing.
def editable_screenshot_sets(platform)
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  version = app.get_edit_app_store_version(platform: platform)
  UI.user_error!("No editable #{platform} version of #{APP_IDENTIFIER} to hold screenshots.") unless version

  version.get_app_store_version_localizations.flat_map(&:get_app_screenshot_sets)
end

# Empties those sets before an upload refills them.
#
# A set holds at most ten images, and deliver's sync uploads before it deletes, so a set already at
# that ceiling has no room to work in and the sync fails outright. Clearing it first also spares the
# sync from reconciling screenshots that are about to be replaced anyway.
#
# The count is re-read from App Store Connect rather than inferred from the deletions: deliver's own
# overwrite path checks the objects it already holds, which is why it reports having removed
# screenshots that are still there.
def purge_remote_screenshots(platform)
  editable_screenshot_sets(platform).each do |set|
    set.app_screenshots.each(&:delete!)
  end

  remaining = editable_screenshot_sets(platform).sum { |set| set.app_screenshots.count }
  return if remaining.zero?

  UI.user_error!("#{remaining} screenshot(s) are still on App Store Connect after being deleted. " \
                 "Uploading now would leave the set a mix of old and new.")
end




# App Store Connect's ceiling on a "What's New" entry.
RELEASE_NOTES_LIMIT = 4000

# One version's release notes, rendered as App Store Connect wants them — the store field shows
# whatever it is given verbatim, so the script strips the Markdown the changelog is written in.
# Raises when the changelog has no section for the version, which is the failure `ci_verify_release
# _notes` exists to reach before anything is built.
def release_notes(version, locale: nil)
  script = File.expand_path("../Scripts/release-notes.sh", __dir__)
  # Not fastlane's `sh`: it reports a failure by printing the Ruby line that called it, so a missing
  # changelog section arrives on CI as a source excerpt rather than as the sentence the script wrote
  # explaining what to add. Capturing lets the script's own message be the error.
  output, status = Open3.capture2e(script, *["--plain", version, locale].compact)
  UI.user_error!(output.strip) unless status.success?
  output.strip
end

# The version record to release into, created if App Store Connect has not got one. `ensure_version!`
# renames a version already in preparation rather than failing beside it: a re-run after a rejected
# build finds the last attempt's version still open, and App Store Connect will not hold a second.
def ensure_store_version(app:, version:, platform:, name:)
  app.ensure_version!(version, platform: platform)
  store_version = app.get_edit_app_store_version(platform: platform)
  UI.user_error!("No editable #{name} version to release #{version} into.") if store_version.nil?
  store_version
end

# Writes the notes onto every locale the listing actually carries, each falling back to the version's
# default section when the changelog has nothing specific to it. Locales are read from App Store
# Connect rather than from the changelog so a mistyped heading cannot publish the app into a
# territory it does not sell in — it just goes unused.
#
# An empty rendering is never written. `ci_verify_release_notes` should have caught that before the
# build, but replacing a release's notes with blankness is bad enough to be worth refusing twice.
def write_release_notes(store_version, version:, name:)
  written = store_version.get_app_store_version_localizations.filter_map do |localization|
    text = release_notes(version, locale: localization.locale)
    if text.empty?
      UI.important("#{name} #{version} rendered no notes for #{localization.locale}; leaving them alone.")
      next nil
    end
    localization.update(attributes: { whats_new: text })
    localization.locale
  end

  UI.success("#{name} #{version} notes written for #{written.join(', ')}.")
end

# How long to wait for App Store Connect to finish processing an upload, and how often to ask.
# Processing usually takes a few minutes and occasionally far longer; the wait is capped so a stuck
# build fails the job rather than holding a runner indefinitely.
BUILD_PROCESSING_TIMEOUT = 45 * 60
BUILD_POLL_INTERVAL = 60

# The version states in which attaching a build is still the developer's to do. Anything further
# along — submitted, in review, accepted, awaiting release, or on sale — belongs to Apple or to the
# store, and swapping the binary underneath it is not something a tag push should do unattended.
#
# An allowlist rather than a denylist, so a state Apple adds later is refused rather than assumed
# safe. Note that `get_edit_app_store_version` returns WAITING_FOR_REVIEW among its "editable"
# states, so without this the attach would reach a version already in Apple's queue.
ATTACHABLE_VERSION_STATES = %w[
  PREPARE_FOR_SUBMISSION
  READY_FOR_REVIEW
  DEVELOPER_REJECTED
  REJECTED
  METADATA_REJECTED
  INVALID_BINARY
].freeze

# The highest-numbered build App Store Connect holds for this version of this platform. Compared as
# integers: build numbers are strings on the API, where "10" sorts below "9".
def newest_build(app:, version:, platform:)
  Spaceship::ConnectAPI::Build.all(app_id: app.id, limit: 200)
                              .select do |build|
                                build.pre_release_version&.version == version &&
                                  build.pre_release_version&.platform == platform
                              end
                              .max_by { |build| build.version.to_i }
end

# Stops a release from changing which binary a version points at once that version has left the
# developer's hands. Attaching is otherwise unattended, so a tag moved while a version sits in
# review would silently swap the build under a submission Apple is already looking at.
def refuse_unsafe_attach(store_version, name:, version:, build_number:)
  state = store_version.app_version_state || store_version.app_store_state
  return if ATTACHABLE_VERSION_STATES.include?(state)

  UI.user_error!(
    "#{name} #{version} is #{state}, so this run will not attach build #{build_number} to it. " \
    "The version has been submitted, and swapping its build now would change what Apple is " \
    "reviewing without anyone saying so.\n\n" \
    "Build #{build_number} is uploaded and will stay there. If it is the one that should ship, " \
    "withdraw the submission and attach it by hand, then resubmit."
  )
end

# Waits for a NAMED build to appear, then for Apple to finish processing it.
#
# Apple indexes an upload some minutes after it arrives, and in that window the newest build App
# Store Connect knows about is the PREVIOUS one — already processed, so a recency-based lookup
# returns it, nothing waits, nothing errors, and the release attaches its own predecessor while
# reporting success. Recency is a proxy for identity that fails in exactly the window this lane
# runs in. The build number is known to the workflow that stamped it, so identity is available and
# is what gets used.
def await_build(app:, version:, platform:, number:, name:)
  deadline = Time.now + BUILD_PROCESSING_TIMEOUT
  loop do
    build = Spaceship::ConnectAPI::Build.all(app_id: app.id, limit: 200).find do |candidate|
      candidate.pre_release_version&.version == version &&
        candidate.pre_release_version&.platform == platform &&
        candidate.version.to_i == number.to_i
    end
    return await_processing(build, name: name) if build

    if Time.now >= deadline
      UI.user_error!("#{name} build #{number} never appeared for #{version} after " \
                     "#{BUILD_PROCESSING_TIMEOUT / 60} minutes. It was uploaded — App Store " \
                     "Connect has not indexed it. Attach it by hand once it shows up.")
    end
    UI.message("#{name} build #{number} has not been indexed yet; asking again in " \
               "#{BUILD_POLL_INTERVAL}s.")
    sleep(BUILD_POLL_INTERVAL)
  end
end

# Waits for Apple to finish processing an upload. A version cannot hold a build that is still
# processing, which is why attaching is the one step of a release that cannot run when the upload
# does — the archive job is long finished before Apple is.
def await_processing(build, name:)
  deadline = Time.now + BUILD_PROCESSING_TIMEOUT
  loop do
    case build.processing_state
      when "VALID" then return build
      when "PROCESSING"
        if Time.now >= deadline
          UI.user_error!("#{name} build #{build.version} was still processing after " \
                         "#{BUILD_PROCESSING_TIMEOUT / 60} minutes. It may yet succeed — re-run " \
                         "this job once App Store Connect shows the build as valid.")
        end
        UI.message("#{name} build #{build.version} is still processing; asking again in " \
                   "#{BUILD_POLL_INTERVAL}s.")
        sleep(BUILD_POLL_INTERVAL)
      else
        UI.user_error!("#{name} build #{build.version} is #{build.processing_state}, so there is " \
                       "nothing to attach. Apple reports why by email.")
    end
    build = Spaceship::ConnectAPI::Build.get(build_id: build.id)
  end
end

platform :ios do
  desc "Generate new localized screenshots"
  lane :screenshots do
    capture_screenshots scheme:           "Generate Screenshots",
                        output_directory: "./fastlane/screenshots"
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    verify_screenshots_present
    ensure_api_key
    purge_remote_screenshots(Spaceship::ConnectAPI::Platform::IOS)
    upload_to_app_store(
      app_identifier:                       APP_IDENTIFIER,
      screenshots_path:                     "./fastlane/screenshots",
      # `overwrite_screenshots` deletes the remote sets and then verifies the deletion against the
      # objects it already held rather than App Store Connect, so it reports success while the old
      # screenshots survive — and the new upload lands beside them until the set hits its ten-image
      # ceiling. Syncing reconciles against what is actually there and confirms the counts agree.
      sync_screenshots:                     true,
      skip_binary_upload:                   true,
      skip_metadata:                        true,
      languages:                            %w[en-US],
      force:                                true,
      run_precheck_before_submit:           false,
      ignore_language_directory_validation: true
    )
  end

  desc "Generate screenshots and upload them"
  lane :screenshots_and_upload do
    screenshots
    upload_screenshots
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    ensure_signing
    increment_build_number xcodeproj: XCODEPROJ
    build_app scheme: SCHEME, export_method: "app-store", output_directory: OUTPUT_DIRECTORY
    upload_to_testflight
    upload_debug_symbols
  end

  desc "Build and upload to App Store"
  lane :release do
    ensure_signing
    increment_build_number xcodeproj: XCODEPROJ
    build_app scheme: SCHEME, export_method: "app-store", output_directory: OUTPUT_DIRECTORY
    upload_to_app_store skip_metadata:     false,
                        skip_screenshots:  false,
                        submit_for_review: false
    upload_debug_symbols
  end

  desc "Resolve the next build number and write it where CI can read it"
  lane :ci_next_build_number do
    ensure_api_key

    # App Store Connect is the authority, not the project file: the checked-in build number drifts
    # behind whatever was last uploaded, and every platform of a release shares one number.
    latest = PLATFORMS.each_value.map do |platform|
      latest_testflight_build_number(app_identifier:       APP_IDENTIFIER,
                                     platform:             platform[:deliver],
                                     initial_build_number: 0)
    end.max

    next_build_number = latest + 1
    UI.success("Next build number: #{next_build_number}")

    # Only CI needs the value in a file to hand to the next job; a local run just wants to see it.
    build_number_file = ENV.fetch("BUILD_NUMBER_FILE", nil)
    File.write(build_number_file, next_build_number) if build_number_file
  end

  desc "Archive one platform and upload it to App Store Connect (CI)"
  lane :ci_release do |options|
    platform = PLATFORMS.fetch(options[:platform]) do
      UI.user_error!("Unknown platform #{options[:platform].inspect}. " \
                     "This app ships #{PLATFORMS.keys.join(', ')}.")
    end

    setup_ci # No-op off CI; elsewhere it keeps match out of the login keychain.
    ensure_signing(match_platform:       platform.fetch(:match),
                   additional_cert_types: platform.fetch(:additional_cert_types, []))

    # One temp key file, shared by the archive and the export.
    authentication_args = provisioning_authentication_args

    build_app(
      scheme:           SCHEME,
      destination:      platform[:destination],
      # The destination decides what gets built; the SDK decides what gym packages. For a
      # multiplatform target it reaches for a .pkg only when the SDK is macosx, so without this the
      # macOS leg archives and exports correctly and then fails looking for an .ipa that a Mac App
      # Store submission never produces.
      sdk:              platform[:sdk],
      export_method:    "app-store",
      output_directory: OUTPUT_DIRECTORY,
      # Passing the version on the command line rather than writing it into the project keeps a
      # release from leaving a commit behind, and stamps every target in the archive alike.
      #
      # The archive signs automatically, exactly as it does in Xcode: `-allowProvisioningUpdates`
      # plus the API key lets it resolve a profile, and the certificate comes from the certificates
      # repository. The export cannot do the same — cloud signing is refused for distribution — so it
      # consumes the stored match profiles instead, which build_app puts into its export options from
      # match's mapping. Hence automatic signing here and managed profiles there.
      xcargs:           "MARKETING_VERSION=#{options.fetch(:version)} " \
                        "CURRENT_PROJECT_VERSION=#{options.fetch(:build)} " \
                        "-allowProvisioningUpdates #{authentication_args}"
    )

    upload_to_app_store(
      app_identifier:             APP_IDENTIFIER,
      platform:                   platform[:deliver],
      skip_metadata:              true,
      skip_screenshots:           true,
      submit_for_review:          false,
      run_precheck_before_submit: false
    )

    upload_debug_symbols
  end

  desc "Refuse to start a release whose notes are missing, empty, or too long (CI)"
  lane :ci_verify_release_notes do |options|
    version = options.fetch(:version)

    # Only the default section is checked. Every locale falls back to it, so if it is present and
    # fits, no locale can be empty — which lets this run with no App Store Connect credentials, and
    # therefore before the build rather than after it.
    notes = release_notes(version)
    UI.user_error!("CHANGELOG.md's #{version} section is empty.") if notes.empty?

    if notes.length > RELEASE_NOTES_LIMIT
      UI.user_error!("The #{version} release notes are #{notes.length} characters; App Store " \
                     "Connect takes at most #{RELEASE_NOTES_LIMIT}.")
    end

    UI.success("#{version} has #{notes.length} characters of release notes.")
  end

  desc "Write the release notes and attach the build to its version (CI)"
  lane :ci_finish_release do |options|
    version = options.fetch(:version)
    number = options[:build]
    ensure_api_key
    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)

    store_versions = PLATFORMS.to_h do |name, platform|
      [name, ensure_store_version(app: app, version: version, platform: platform.fetch(:connect),
                                  name: name)]
    end

    # Every platform's notes first, then the attaching. Attaching waits on Apple and can fail on a
    # build Apple rejects, and notes that landed are worth more than notes withheld because a
    # binary went bad.
    store_versions.each { |name, store_version| write_release_notes(store_version, version: version, name: name) }

    store_versions.each do |name, store_version|
      platform = PLATFORMS.fetch(name)
      # Before the wait, not after: there is no sense spending up to forty-five minutes waiting on
      # a build that will be refused the moment it arrives. The check reads the version's state and
      # needs no build object — only the message names one — so a number is enough to run it early.
      refuse_unsafe_attach(store_version, name: name, version: version,
                           build_number: number || "the newest")

      build = if number
                await_build(app: app, version: version, platform: platform.fetch(:connect),
                            number: number, name: name)
              else
                # No number to wait for, so the newest build has to stand in for the right one.
                # Only a hand-run release reaches this: the workflow always knows what it built.
                UI.important("No build number given, so #{name} will attach whichever build is " \
                             "newest. If a release is still uploading, that is the one before it.")
                newest = newest_build(app: app, version: version, platform: platform.fetch(:connect))
                UI.user_error!("App Store Connect has no #{name} build for #{version}.") if newest.nil?
                await_processing(newest, name: name)
              end

      store_version.select_build(build_id: build.id)
      UI.success("#{name} #{version} now ships build #{build.version}.")
    end
  end

  # Loads the App Store Connect API key. Kept out of `before_all` so `screenshots`, which runs
  # entirely against local simulators, needs no credentials at all.
  private_lane :ensure_api_key do
    required_env("MATCH_PASSWORD") # Decrypts the key; bin/api-key would otherwise fail obscurely.
    key = JSON.parse(sh(File.join(certificates_repo, "bin", "api-key"), "--stdout", log: false))
    app_store_connect_api_key(
      key_id:      key["key_id"],
      issuer_id:   key["issuer_id"],
      key_content: key["key"]
    )
  end

  # Everything an archive needs to be signed and accepted.
  #
  # Two certificates, because an archive and its export sign differently: `xcodebuild archive` uses a
  # development identity, just as Xcode does locally, and `exportArchive` re-signs the payload for
  # distribution. Keeping the development certificate here means a runner installs it instead of
  # minting a throwaway one every release — a team holds only a few, and automatic signing will
  # exhaust the quota.
  #
  # Skipping profiles on that first call keeps it platform-agnostic: the archive gets its profile
  # from `-allowProvisioningUpdates`, and the certificate is all match is being asked for. It must
  # come first, because match records a profile mapping whether or not it synced any — the
  # development call maps every bundle identifier to nil, so the App Store call has to be the one
  # that wins. The export signs with that mapping, which is why the second call is told which
  # platform's profile to sync: the export rejects a profile built for a different one.
  private_lane :ensure_signing do |options|
    ensure_api_key
    match(type: "development", readonly: true, skip_provisioning_profiles: true)
    match(readonly: true,
          platform:              options.fetch(:match_platform, "ios"),
          additional_cert_types: options.fetch(:additional_cert_types, []))
  end

  # Uploads dSYMs and source context so Sentry can symbolicate the build that was just shipped.
  # The Xcode run-script phase does this too, but only when `sentry-cli` happens to be installed
  # on the archiving machine; doing it here makes symbolication a property of the release instead.
  #
  # The archive's dSYMs directory is the source, not DSYM_OUTPUT_PATH: build_app does not read that
  # path back from gym, it reconstructs it by substituting an extension onto the exported binary's
  # path. The macOS leg exports a .pkg, for which it derives `<name>.dSYM.zip` — while gym writes
  # `<name>.app.dSYM.zip`. That path never exists, so DSYM_OUTPUT_PATH stays nil and the Mac build
  # would ship unsymbolicated every release. The archive directory needs no such guess, and holds
  # every dSYM the build produced.
  #
  # `sentry-cli` is invoked directly rather than through an action: the built-in
  # `upload_symbols_to_sentry` is deprecated to a hard error, and Sentry's replacement plugin is not
  # installed.
  private_lane :upload_debug_symbols do
    dsym_path = File.join(lane_context[SharedValues::XCODEBUILD_ARCHIVE].to_s, "dSYMs")
    unless Dir.exist?(dsym_path)
      UI.important("The archive carries no dSYMs, so there is nothing to symbolicate.")
      next
    end

    # By the time this runs the binary is already in App Store Connect, so nothing here is allowed to
    # fail the release — a missing token or a rejected upload costs symbolication, not the build, and
    # `sentry-cli debug-files upload` can be re-run by hand afterwards.
    token = ENV.fetch("SENTRY_AUTH_TOKEN", nil)
    if token.nil? || token.empty?
      UI.important("SENTRY_AUTH_TOKEN is not set; skipping the Sentry upload of #{dsym_path}.")
      next
    end

    begin
      sh("sentry-cli", "debug-files", "upload",
         "--org", SENTRY_ORG,
         "--project", SENTRY_PROJECT,
         "--include-sources",
         dsym_path)
    rescue StandardError => error
      UI.error("Sentry rejected the dSYM upload: #{error.message}")
      UI.important("The build itself uploaded fine; re-run sentry-cli once the token is valid.")
    end
  end
end
