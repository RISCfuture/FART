# fastlane loads `fastlane/.env` on startup. Copy this file to `.env` and fill in the values; `.env`
# is git-ignored. On CI these same names arrive as GitHub Actions secrets, so no file is involved.

# Passphrase that decrypts the certificates repository — both the signing certificates and the
# App Store Connect API key are locked with it.
MATCH_PASSWORD=

# Token `sentry-cli` authenticates with to upload dSYMs after an archive.
SENTRY_AUTH_TOKEN=

# Only needed if the certificates repository is not checked out at ~/Repositories/certificates.
# CERTIFICATES_REPO=

# Opts into deliver's screenshot synchronisation, which `upload_screenshots` relies on. Its
# predecessor verified its own deletions against objects it already held rather than against App
# Store Connect, so it reported success while the old screenshots survived and the new ones piled up
# beside them. Only the local screenshot lanes need this; the release workflow skips screenshots.
FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS=true
